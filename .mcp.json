{
  "mcpServers": {
    "ux-recording": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/dist/mcp-server/bundle.js"]
    },
    "chrome-devtools-2": {
      "command": "npx",
      "args": [
        "chrome-devtools-mcp@latest",
        "--isolated",
        "--channel",
        "beta",
        "--chromeArg=--start-fullscreen"
      ]
    },
    "chrome-devtools-3": {
